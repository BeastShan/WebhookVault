{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "resolveJsonModule": true
  },
  "include": ["server/**/*.ts", "scripts/**/*.ts", "test/**/*.ts", "browser/**/*.ts", "playwright.config.ts", "dashboard/**/*.tsx", "dashboard/**/*.ts"],
  "exclude": ["node_modules", "dashboard/.next"]
}
